{
  "expo": {
    "name": "Portaria Encomendas",
    "slug": "portaria-encomendas",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.portaria.encomendas"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.portaria.encomendas"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Permite fotografar etiquetas de encomendas para transcrever o texto."
        }
      ]
    ],
    "scheme": "portaria"
  }
}
